{
  "name": "kt03",
  "version": "1.0.0",
  "private": true,
  "description": "REST API блога на Express, Prisma и SQLite",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "setup": "node scripts/setup-env.js && prisma generate && prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "joi": "18.0.1"
  },
  "devDependencies": {
    "prisma": "6.19.2"
  }
}
